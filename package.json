{
  "name": "quickgames-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "firebase emulators:exec --project demo-quickgames --only auth,firestore \"node e2e/run.mjs\"",
    "server:build": "./gradlew :server:installDist",
    "server": "QUICKGAMES_POLL=true FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GOOGLE_CLOUD_PROJECT=demo-quickgames SERVER_PORT=8081 ./server/build/install/server/bin/server"
  },
  "devDependencies": {
    "firebase": "^12.0.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^14.0.0"
  }
}
