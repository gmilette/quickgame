rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function gameData(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /queues/{queueId}/entries/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    match /games/{gameId} {
      allow read: if signedIn() && request.auth.uid in resource.data.playerUids;
      allow write: if false;

      match /submissions/{subId} {
        allow read: if signedIn() && request.auth.uid in gameData(gameId).playerUids;
        allow create: if signedIn()
          && gameData(gameId).status == 'active'
          && gameData(gameId).activePlayerId == request.auth.uid
          && subId == string(gameData(gameId).round) + '-' + request.auth.uid
          && request.resource.data.keys().hasOnly(['payloadJson', 'submittedAt'])
          && request.resource.data.payloadJson is string
          && request.resource.data.payloadJson.size() < 100000
          && request.resource.data.submittedAt == request.time;
        allow update, delete: if false;
      }

      match /logs/{logId} {
        allow read: if signedIn() && request.auth.uid in gameData(gameId).playerUids;
        allow write: if false;
      }
    }
  }
}
